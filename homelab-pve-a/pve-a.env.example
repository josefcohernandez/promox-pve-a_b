# Copiar a pve-a.env y rellenar. El script se niega a arrancar si falta algo obligatorio.

# ---- Obligatorio ----
# Clave pública SSH que entra en prod y dev (usuario VM_USER)
SSH_PUBKEY="ssh-ed25519 AAAA... jose@workstation"
# Usuario con sudo dentro de prod y dev
VM_USER="jose"
# Password de VM_USER solo para la consola de Proxmox (SSH sigue solo con clave). Se guarda como hash SHA-512
VM_PASSWORD="cambiame"
# IP del Synology (export NFS /volume1/pbs)
NAS_IP="192.168.130.X"
# Password de root del LXC de PBS (es también el login root@pam de la web de PBS)
PBS_ROOT_PASSWORD="cambiame"

# ---- Máquinas: hostname, IP y MAC ----
# HOSTNAME vacío -> valor por defecto (prod / dev / pbs). Se usa como nombre en Proxmox y como hostname del SO.
# IP vacía       -> DHCP (reserva la IP en el MikroTik por MAC). Con valor -> IP fija por cloud-init, p. ej. "192.168.130.100".
# MAC vacía      -> se genera una fija y predecible a partir del VMID (BC:24:11:A0:<vmid>:<nic>) para que la reserva DHCP
#                   sobreviva a recrear la VM. Se imprimen al final. Con valor -> se usa la que indiques.
PROD_HOSTNAME=""
PROD_IP=""
PROD_MAC=""

DEV_HOSTNAME=""
DEV_IP=""
DEV_MAC=""

PBS_HOSTNAME=""
PBS_IP=""             # si va por DHCP, el script descubre la IP al registrar el storage en Proxmox
PBS_MAC=""

# ---- Normalmente no hace falta tocar nada de aquí abajo ----
NODE_NAME="pve-a"
NODE_IP="192.168.130.11"
LAN_CIDR="24"
LAN_GW="192.168.130.1"
LAN_DNS="192.168.130.1"
LAN_DOMAIN="domain.com"
STORAGE="local-lvm"
UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-amd64.img"
UBUNTU_SUMS_URL="https://cloud-images.ubuntu.com/releases/26.04/release/SHA256SUMS"
