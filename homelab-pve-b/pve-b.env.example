# Copiar a pve-b.env y rellenar.

# Clave pública SSH generada EN dev (ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -C tofu@dev).
# La usa el provider bpg para subir snippets de cloud-init por SSH.
TOFU_SSH_PUBKEY="ssh-ed25519 AAAA... tofu@dev"

# --- Normalmente no hace falta tocar nada de aquí abajo ---
NODE_NAME="pve-b"
NODE_IP="192.168.130.12"
LAN_CIDR="24"
LAN_GW="192.168.130.1"
LAN_DNS="192.168.130.1"
LAN_DOMAIN="home.esojfware.com"
STORAGE="local-lvm"
